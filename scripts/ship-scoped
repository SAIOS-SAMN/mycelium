#!/usr/bin/env bash
# SHIP-SCOPED — the scoped check for a change: clippy on the crate, then the
# library tests named by the filters given, each suite's `test result` line
# printed. MU-STANDARDS §3.9: a change runs the suites of the modules it
# touches; `scripts/check` is the whole check before a pull request.
#
# Usage: scripts/ship-scoped <test filter>...
#   e.g. scripts/ship-scoped transducer::family::tests::elements
#   CARGO_TARGET_DIR is honoured; the test log is kept at $SHIP_LOG
#   (default: a temporary file).
set -u
cd "$(dirname "$0")/.." || exit 1

if [ "$#" -eq 0 ]; then
  echo "usage: scripts/ship-scoped <test filter>..." >&2
  exit 2
fi

LOG="${SHIP_LOG:-$(mktemp "${TMPDIR:-/tmp}/ship-scoped.XXXXXX")}"

echo "head $(git log --oneline -1)"
if cargo clippy --release --lib --bins --tests 2>&1 | grep -E "^error" -A12; then
  echo "STOPPED: clippy"
  exit 1
fi
cargo test --release --lib -- "$@" >"$LOG" 2>&1
grep -E "^test result" "$LOG"
if grep -qE "FAILED|panicked|^error" "$LOG"; then
  grep -E "FAILED|panicked|^error" "$LOG" | head -5
  echo "STOPPED: tests (log $LOG)"
  exit 1
fi
echo "GREEN: clippy and the scoped tests (log $LOG)"
