#!/usr/bin/env bash
# READINGS — what the fleet says about itself, taken from the artifacts and
# not from a model of them. Run by the operator, owned by the repository.
#
# Usage: scripts/readings [SINCE] [HOME_ROOT]
#        SINCE defaults to `-5m` (journalctl's form); HOME_ROOT to <repo>/var
#
# Every measurement a Stage 15 row owes is here, each printed beside the
# reading it is to be read against, so a relaunch is surveyed by running one
# command rather than by remembering eight greps. A line that reads zero
# because nothing ran is not a passing line: the counts are printed with the
# window they were taken over, and an empty window says so.
#
# THE CPU SHARE IS SYSTEMD'S OWN COUNTER, not a sample: `CPUUsageNSec` over
# the time since the unit became active. X6's row was opened on a reading
# scraped from `systemctl status` at one instant; this is the whole window.
set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
SINCE="${1:--5m}"
ROOT="${2:-$REPO/var}"
VOICES=(1 2 3 4 5)
HYPHAE=(a b c)

say() { printf '%s\n' "$*"; }
hr() { printf -- '--- %s\n' "$*"; }

# One unit's share of a core over its whole active window, from systemd's
# accounting rather than a sample of it.
#
# A STOPPED UNIT HAS NO SHARE. `CPUUsageNSec` survives the stop and
# `ActiveEnterTimestampMonotonic` still names the last activation, so
# dividing one by the other for a dead unit spreads the CPU it spent while
# running across every second it has been dead — a fleet stopped overnight
# reads 1% and looks idle. The elapsed window is only a window while the
# unit is in it: a stopped unit reports what it consumed and says so.
share() {
  local unit="$1" cpu start now
  cpu="$(systemctl --user show "$unit" -p CPUUsageNSec --value 2>/dev/null)"
  start="$(systemctl --user show "$unit" -p ActiveEnterTimestampMonotonic --value 2>/dev/null)"
  if [ -z "$cpu" ] || [ "$cpu" = "[not set]" ]; then
    printf 'cpu unmeasured'
    return
  fi
  if [ "$(systemctl --user is-active "$unit" 2>/dev/null)" != "active" ]; then
    awk -v c="$cpu" 'BEGIN { printf "not running; spent %.1fs of CPU while it was", c / 1e9 }'
    return
  fi
  if [ -z "$start" ] || [ "$start" = "0" ]; then
    printf 'cpu unmeasured'
    return
  fi
  now="$(awk '{printf "%d", $1*1000000}' /proc/uptime)"
  awk -v c="$cpu" -v s="$start" -v n="$now" 'BEGIN {
    el = (n - s) * 1000;
    if (el <= 0) { printf "cpu unmeasured"; exit }
    printf "%.1f%% of a core over %.0fs", 100 * c / el, el / 1e9
  }'
}

# Matching lines in one unit's journal over the window. The count and the
# last line both, because a count alone cannot be read.
lines() {
  local unit="$1" pat="$2" n last
  n="$(journalctl --user -u "$unit" --since "$SINCE" --no-pager 2>/dev/null | grep -c -- "$pat")"
  last="$(journalctl --user -u "$unit" --since "$SINCE" --no-pager 2>/dev/null | grep -- "$pat" | tail -1 | sed 's/^[^]]*]: //')"
  printf '%6s  %s\n' "$n" "${last:-—}"
}

say "readings over ${SINCE}, fleet at $(git -C "$REPO" rev-parse --short HEAD)"
say ""

hr "the layouts on disk (X7's observable, X8's magic)"
for h in "${HYPHAE[@]}" "${VOICES[@]}"; do
  m="$(head -c 4 "$ROOT/$h/mesh" 2>/dev/null || echo '(none)')"
  l="$(head -c 4 "$ROOT/$h/ledger" 2>/dev/null || echo '(none)')"
  g="$(head -c 4 "$ROOT/$h/genome" 2>/dev/null || echo '(none)')"
  printf '  %-3s mesh %-6s ledger %-6s genome %s\n' "$h" "$m" "$l" "$g"
done
say "  X7 closes when every mesh reads MSH2; X8's ledgers read MYC5 once a court has persisted."
say ""

hr "the courts"
for h in "${HYPHAE[@]}"; do
  u="mycelium-server@$h"
  st="$(systemctl --user is-active "$u" 2>/dev/null)"
  printf '  [%s] %s, %s, restarts %s\n' "$h" "$st" "$(share "$u")" \
    "$(systemctl --user show "$u" -p NRestarts --value 2>/dev/null)"
  printf '    boot refused      '; lines "$u" 'boot refused'
  printf '    ledger refused    '; lines "$u" 'ledger refused'
  printf '    ledger MYC5       '; lines "$u" 'ledger MYC5'
  printf '    read as MSH1      '; lines "$u" 'read as MSH1'
  printf '    digest refused    '; lines "$u" 'cover digest refused'
  printf '    cover page over   '; lines "$u" 'cover page passed over'
  printf '    cover read        '; lines "$u" 'court cover read'
  printf '    exchange admitted '; lines "$u" 'court exchange admitted'
  printf '    court basis       '; lines "$u" 'court basis='
  printf '    orbit docket      '; lines "$u" 'court orbit docket'
done
say ""

hr "the voices"
for v in "${VOICES[@]}"; do
  u="mycelium-client@$v"
  st="$(systemctl --user is-active "$u" 2>/dev/null)"
  printf '  [%s] %s, %s, restarts %s\n' "$v" "$st" "$(share "$u")" \
    "$(systemctl --user show "$u" -p NRestarts --value 2>/dev/null)"
  printf '    stroke idle       '; lines "$u" 'stroke idle'
  printf '    quote asked       '; lines "$u" 'quote asked'
  printf '    clusters          '; lines "$u" 'clusters'
  printf '    fed / derived     '; lines "$u" 'fed [0-9]'
  printf '    learned           '; lines "$u" 'learned'
done
say ""

hr "what these are read against (the readings that opened the rows, fc75a59 / 3d2987e)"
say "  X6  every voice 81–87% of a core with 'quote 0 clusters'; a stroke that"
say "      admits nothing now parks, so an idle voice is expected well under a tenth."
say "  X7  MSH1 on all eight; now expected MSH2 on all eight once each has booted."
say "  X8  hypha b: 'ledger refused in section KCH1 at byte 14324354' then"
say "      'court basis=0 K=0' for two epochs. Expected: it restores, or it refuses"
say "      the boot outright — never a court that comes up empty."
say "  X9  a and b refused 438 of 457 cover digests in five minutes with"
say "      'charts 65 of which 12 wider than the axis count'. Expected: no digest"
say "      refused for width at all, and 'court cover read N charts' standing."
