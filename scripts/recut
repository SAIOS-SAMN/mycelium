#!/usr/bin/env bash
# RECUT — 45.5's provisioning, run by the operator, owned by the repository.
#
# H_genesis is written ONCE by the first hypha started on a fresh state and
# provisioned to every other node the way the bootstrap peer list is. That
# is a PROCEDURE, not a persistent flag: `--mint-genesis` on a unit makes a
# node re-mint whenever systemd restarts it, and `--recut` on a unit drops
# the origin and bumps the epoch on every restart. Both belong here, run
# once, and nowhere else.
#
# Usage: scripts/recut [HOME_ROOT]        (default ~/.mycelium)
#
# Order matters. Voices go down first so nothing speaks into a mesh that is
# being re-originated; hyphae go down in reverse of the order they come up,
# so the minting hypha is the last to stop and the first to start.
set -euo pipefail

ROOT="${1:-$HOME/.mycelium}"
VOICES=(1 2 3 4 5)
HYPHAE=(a b c)
MINTER="${HYPHAE[0]}"
BIN="$(cd "$(dirname "$0")/.." && pwd)/target/release/mycelium-server"

say() { printf '  recut: %s\n' "$*"; }

say "stopping voices"
for v in "${VOICES[@]}"; do systemctl --user stop "mycelium-client@$v" 2>/dev/null || true; done
say "stopping hyphae"
for h in $(printf '%s\n' "${HYPHAE[@]}" | tac); do
  systemctl --user stop "mycelium-server@$h" 2>/dev/null || true
done

# MU-STANDARDS §10: nothing persisted survives a recut. Ledgers, the
# registry snapshot beside the ledger or under corpora/, genomes (which carry
# the thoughts) go; keys, the mesh record and the corpora stay. A layout
# change is a recut and no reader for an older layout exists, so a carrier
# left here would only be refused at boot.
say "wiping persisted carriers"
for h in "${HYPHAE[@]}"; do
  rm -f "$ROOT/$h/ledger" "$ROOT/$h/ledger.tmp" "$ROOT/$h/ledger.registry" \
        "$ROOT/$h/corpora/registry" "$ROOT/$h/corpora/registry.tmp"
done
for v in "${VOICES[@]}"; do
  rm -f "$ROOT/$v/genome" "$ROOT/$v/genome.tmp"
done

# The mesh record is SIGNED, so a genesis cannot be cleared from outside the
# process that holds the key: each hypha drops its own origin, in a one-shot
# run of the binary, and exits.
say "dropping origins"
for h in "${HYPHAE[@]}"; do
  timeout 30 "$BIN" --home "$ROOT/$h" --recut || true
done

say "minting on $MINTER"
systemctl --user start "mycelium-server@$MINTER"
# The minter must hold its origin before a peer asks, or the peer adopts
# nothing and the sweep repeats. One aperture is enough; the loop below
# waits for the line rather than guessing a duration.
for _ in $(seq 1 60); do
  if journalctl --user -u "mycelium-server@$MINTER" --since "-2 min" -o cat 2>/dev/null \
     | grep -q "court genesis .* written"; then break; fi
  sleep 2
done

say "starting the rest"
for h in "${HYPHAE[@]}"; do
  [ "$h" = "$MINTER" ] && continue
  systemctl --user start "mycelium-server@$h"
done
for v in "${VOICES[@]}"; do systemctl --user start "mycelium-client@$v"; done

say "done — read: court genesis … adopted from, then court receipts … refused-origin 0"
