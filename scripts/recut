#!/usr/bin/env bash
# RECUT — 45.5's provisioning, run by the operator, owned by the repository.
#
# H_genesis is written ONCE by the first hypha started on a fresh state and
# provisioned to every other node the way the bootstrap peer list is. That
# is a PROCEDURE, not a persistent flag: `--mint-genesis` on a unit makes a
# node re-mint whenever systemd restarts it, and `--recut` on a unit drops
# the origin and bumps the epoch on every restart. Both belong here, run
# once, and nowhere else.
#
# Usage: scripts/recut [HOME_ROOT]        (default <repository>/var)
#
# The fleet's homes live under the repository, `var/<unit>` (2026-09-09:
# moved out of the operator's home directory); keys, mesh records and corpus
# manifests are configuration and stay, everything else is state and goes.
#
# Order matters. Voices go down first so nothing speaks into a mesh that is
# being re-originated; hyphae go down in reverse of the order they come up,
# so the minting hypha is the last to stop and the first to start.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="${1:-$REPO/var}"
VOICES=(1 2 3 4 5)
# The seat minds' homes (transient units: barren's s1, xylarium's x0–x3,
# netstratum's n1–n4): their genomes carry the old court's stamps too.
SEAT_HOMES=(s1 x0 x1 x2 x3 n1 n2 n3 n4)
HYPHAE=(a b c)
MINTER="${HYPHAE[0]}"
BIN="$REPO/target/release/mycelium-server"

say() { printf '  recut: %s\n' "$*"; }

# WHAT IS ABOUT TO BE WIPED, READ FIRST. A recut deletes every court's
# history; the operator is entitled to see what each home holds and what
# this build would do with it before the deletion, not after. `--check`
# starts nothing and changes nothing it reports on. Exit 3 from it is "this
# home will not boot on this build", which is the ordinary reading after a
# layout change (§10) and not a reason to stop.
say "surveying the homes (nothing is changed by this)"
for h in "${HYPHAE[@]}"; do
  "$BIN" --home "$ROOT/$h" --check 2>&1 | sed 's/^/    /' || true
done
for v in "${VOICES[@]}"; do
  printf '    %s/%s: mesh %s, genome %s\n' "$ROOT" "$v" \
    "$(head -c 4 "$ROOT/$v/mesh" 2>/dev/null || echo '(none)')" \
    "$(head -c 4 "$ROOT/$v/genome" 2>/dev/null || echo '(none)')"
done

say "stopping voices"
for v in "${VOICES[@]}"; do systemctl --user stop "mycelium-client@$v" 2>/dev/null || true; done
# Seat minds are transient units: stopped here so none rewrites its genome
# after the wipe; they are NOT restarted by this script — each is relaunched
# (systemd-run) once its house has re-founded and re-posted its seats.
say "stopping seat minds (relaunch them after their houses re-post)"
for u in $(systemctl --user list-units --no-legend --plain 'mycelium-seat-*' 'mycelium-xseat-*' 'mycelium-nseat-*' | awk '{print $1}'); do
  systemctl --user stop "$u" 2>/dev/null || true
done
say "stopping hyphae"
for h in $(printf '%s\n' "${HYPHAE[@]}" | tac); do
  systemctl --user stop "mycelium-server@$h" 2>/dev/null || true
done

# MU-STANDARDS §10: nothing persisted survives a recut. Ledgers, the
# registry snapshot beside the ledger or under corpora/, genomes (which carry
# the thoughts) go; keys, the mesh record and the corpora stay. A layout
# change is a recut and no reader for an older layout exists, so a carrier
# left here would only be refused at boot.
say "wiping persisted carriers"
for h in "${HYPHAE[@]}"; do
  rm -f "$ROOT/$h/ledger" "$ROOT/$h/ledger.tmp" "$ROOT/$h/ledger.registry" \
        "$ROOT/$h/corpora/registry" "$ROOT/$h/corpora/registry.tmp" \
        "$ROOT/$h/eras" "$ROOT/$h/line" "$ROOT/$h/line.tmp" \
        "$ROOT/$h/corpora/cursor" "$ROOT/$h/corpora/cursor.tmp" \
        "$ROOT/$h/keeper" "$ROOT/$h/keeper.tmp"
done
for v in "${VOICES[@]}" "${SEAT_HOMES[@]}"; do
  rm -f "$ROOT/$v/genome" "$ROOT/$v/genome.tmp"
done

# The mesh record is SIGNED, so a genesis cannot be cleared from outside the
# process that holds the key: each hypha drops its own origin, in a one-shot
# run of the binary, and exits.
say "dropping origins"
for h in "${HYPHAE[@]}"; do
  timeout 30 "$BIN" --home "$ROOT/$h" --recut || true
done

# 45.5: H_genesis is written ONCE by the first hypha started on a fresh
# state, and the binary mints only when told (`--mint-genesis`). The unit
# starts the binary with `--home` and nothing else (§10), so the flag is
# passed here, to a ONE-SHOT run of the binary in the foreground of this
# script: it needs a first receipt to hash — the corpus intake seals one on
# its first listing — and the run ends when the line appears or the bound
# is spent. The unit then boots on the mesh record that run signed, which
# is how the origin reaches every restart without a flag on the unit. It
# started the unit and waited for a line the unit could never write: the
# fleet came up with `genesis unwritten` on every node (2026-09-08).
say "minting on $MINTER"
MINT_LOG="$ROOT/$MINTER/mint.log"
timeout 180 "$BIN" --home "$ROOT/$MINTER" --mint-genesis >"$MINT_LOG" 2>&1 &
MINT_PID=$!
for _ in $(seq 1 60); do
  if grep -q "court genesis .* written" "$MINT_LOG" 2>/dev/null; then break; fi
  sleep 2
done
# SIGINT: the binary's handler persists the ledger and exits; the mesh
# record was signed when the genesis was written.
kill -INT "$MINT_PID" 2>/dev/null || true
wait "$MINT_PID" 2>/dev/null || true
if grep -q "court genesis .* written" "$MINT_LOG" 2>/dev/null; then
  say "genesis written: $(grep -m1 'court genesis .* written' "$MINT_LOG")"
else
  say "genesis NOT written within the bound — read $MINT_LOG before starting the rest"
fi

if [ "${PAUSE_BEFORE_START:-0}" = "1" ] || [ "${NO_START:-0}" = "1" ]; then
  say "paused before starting fleet on operator directive"
  exit 0
fi

systemctl --user start "mycelium-server@$MINTER"

say "starting the rest"
for h in "${HYPHAE[@]}"; do
  [ "$h" = "$MINTER" ] && continue
  systemctl --user start "mycelium-server@$h"
done
for v in "${VOICES[@]}"; do systemctl --user start "mycelium-client@$v"; done

# THE PROCEDURE TAKES ITS OWN READING. This ended at "done — read: …" and
# left the reading to be remembered and typed by hand, eight greps of it,
# which is how a relaunch gets reported as working because nobody looked.
# `scripts/readings` is that reading, and it is the same one whether it is
# run from here or on its own an hour later.
SOAK="${SOAK:-300}"
say "soaking ${SOAK}s before the reading"
sleep "$SOAK"
say "reading the fleet"
"$REPO/scripts/readings" "-$((SOAK / 60 + 1))m" "$ROOT"
