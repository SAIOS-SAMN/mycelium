#!/usr/bin/env bash
# QUICK START — a Mycelium network on one machine: three hyphae (courts) and
# one SDK client, provisioned and started from nothing, the client solving
# tasks the courts adjudicate and pay; then the conformance read of both
# profiles, a kernel's house founding a domain, a mind seated in that
# house's domain (`mycelium-client --seat`) filing its solve under its own
# key, the observer's frame of the mesh (scripts/observer) and the timeline
# of the client's traced journal (scripts/timeline). Where the seated mind's
# solve is not judged under its own key, or the observer or the timeline
# fails, the run exits 1. The network keeps running until Ctrl-C, then every
# process stops; the homes stay in DIR for inspection.
#
# AGENTS.md › Checks requires this run for a change to the wire or the
# mesh; CI does not run it.
#
# Usage: scripts/quickstart [DIR] [BASE_PORT] [TASKS]
#   DIR        where the homes are written (default: $TMPDIR/mycelium-quickstart,
#              cleared first)
#   BASE_PORT  the hyphae serve on BASE_PORT, +1, +2 (default 7700)
#   TASKS      how many tasks the SDK client asks for (default 8)
#
# The ARC-AGI-2 corpus is read from $MYCELIUM_CORPUS or data/arc-agi-2; its
# first 30 training tasks, read by the corpus's decoder (`mycelium-arc-agi`,
# the workspace crate sources/arc-agi) and written as posted tasks, form the
# network's corpus: the hyphae read posted tasks and no dataset's format.
# The binaries are read from $CARGO_TARGET_DIR (default target/).
set -u
cd "$(dirname "$0")/.." || exit 1
ROOT=$(pwd)
DIR="${1:-${TMPDIR:-/tmp}/mycelium-quickstart}"
BASE="${2:-7700}"
TASKS="${3:-8}"
CORPUS_ROOT="${MYCELIUM_CORPUS:-$ROOT/data/arc-agi-2}"
TARGET="${CARGO_TARGET_DIR:-$ROOT/target}"
SRV="$TARGET/release/mycelium-server"
CLI="$TARGET/release/mycelium-client"
EX="$TARGET/release/examples/client"
CONF="$TARGET/release/examples/conformance"
HOUSE="$TARGET/release/examples/house"
SEATS="$TARGET/release/examples/seats"
DECODE="$TARGET/release/mycelium-arc-agi"
# How long the seated stage waits on the house, in seconds: a bound on the
# run, never a reading of the mind.
SEAT_WAIT="${MYCELIUM_SEAT_WAIT:-1800}"
# How many of the court's tasks the house sets before the seat, one at a
# time while the mind declines (default: the corpus's 30).
SEAT_TASKS="${MYCELIUM_SEAT_TASKS:-30}"
# How long the courts' judged readings are read for the seated solve, in
# seconds.
JUDGED_WAIT="${MYCELIUM_JUDGED_WAIT:-120}"
say() { printf '\n\033[1m== %s\033[0m\n' "$*"; }

if [ ! -d "$CORPUS_ROOT/training" ]; then
  echo "No ARC-AGI-2 corpus at $CORPUS_ROOT/training."
  echo "Fetch it, for example:"
  echo "  git clone --depth 1 https://github.com/arcprize/ARC-AGI-2 ../ARC-AGI-2"
  echo "  mkdir -p data && ln -s \"\$(cd ../ARC-AGI-2/data && pwd)\" data/arc-agi-2"
  exit 1
fi

if [ ! -x "$SRV" ] || [ ! -x "$CLI" ] || [ ! -x "$EX" ] || [ ! -x "$CONF" ] || [ ! -x "$HOUSE" ] || [ ! -x "$SEATS" ] || [ ! -x "$DECODE" ]; then
  say "building (release)"
  cargo build --release --bins || exit 1
  cargo build --release -p mycelium-sdk --example client --example conformance --example house --example seats || exit 1
  cargo build --release -p mycelium-source-arc-agi --bin mycelium-arc-agi || exit 1
fi

PIDS=()
stop() {
  for p in "${PIDS[@]}"; do kill "$p" 2>/dev/null; done
  wait 2>/dev/null
  echo; echo "stopped; the homes are in $DIR"
}
trap stop EXIT
trap 'exit 0' INT TERM

rm -rf "$DIR"; mkdir -p "$DIR/corpus"
"$DECODE" decode "$CORPUS_ROOT/training" "$DIR/corpus" 30 || exit 1
PORT_a=$BASE; PORT_b=$((BASE + 1)); PORT_c=$((BASE + 2))
port() { eval "echo \$PORT_$1"; }

say "1. identities: one key per node"
for n in a b c; do "$SRV" --home "$DIR/$n" --init || exit 1; done | tee "$DIR/init.txt"
"$CLI" --home "$DIR/client" --init | tee -a "$DIR/init.txt" || exit 1
"$CLI" --home "$DIR/seated" --init | tee -a "$DIR/init.txt" || exit 1

say "2. the genesis allocation, and each hypha's address and peers"
grep '^genesis line: hypha' "$DIR/init.txt" | cut -d' ' -f3- > "$DIR/genesis"
grep '^genesis line: voice' "$DIR/init.txt" | cut -d' ' -f3-4 | sed 's/$/ 8 8 1 8/' >> "$DIR/genesis"
cat "$DIR/genesis"
for n in a b c; do
  echo "127.0.0.1:$(port "$n")" > "$DIR/$n/bind"
  for m in a b c; do
    if [ "$m" != "$n" ]; then echo "127.0.0.1:$(port "$m")"; fi
  done > "$DIR/$n/peers"
  cp "$DIR/genesis" "$DIR/$n/genesis"
done

say "3. the corpus, signed by hypha a and registered on every hypha"
"$SRV" --home "$DIR/a" --sign-corpus "$DIR/corpus" || exit 1
for n in b c; do cp "$DIR/a/corpora/corpus.manifest" "$DIR/$n/corpora/"; done

say "4. start: hypha a mints the genesis, b and c adopt it"
"$SRV" --home "$DIR/a" --mint-genesis > "$DIR/a.log" 2>&1 & PIDS+=($!)
minted=0
for _ in $(seq 1 120); do
  if grep -q 'genesis .* written' "$DIR/a.log"; then minted=1; break; fi
  if ! kill -0 "${PIDS[0]}" 2>/dev/null; then break; fi
  sleep 1
done
if [ "$minted" != 1 ]; then echo "hypha a wrote no genesis; see $DIR/a.log"; exit 1; fi
grep -m1 'genesis .* written' "$DIR/a.log"
"$SRV" --home "$DIR/b" > "$DIR/b.log" 2>&1 & PIDS+=($!)
"$SRV" --home "$DIR/c" > "$DIR/c.log" 2>&1 & PIDS+=($!)
adopted=0
for _ in $(seq 1 180); do
  n=0
  for h in b c; do
    if "$SRV" --home "$DIR/$h" --check 2>/dev/null | grep -q 'genesis [0-9a-f]'; then n=$((n + 1)); fi
  done
  if [ "$n" = 2 ]; then adopted=1; break; fi
  sleep 1
done
for h in a b c; do echo "$h: $("$SRV" --home "$DIR/$h" --check 2>/dev/null | grep '^  mesh:')"; done
if [ "$adopted" != 1 ]; then echo "b and c did not adopt the genesis; see $DIR/b.log, $DIR/c.log"; exit 1; fi

say "5. the SDK client works $TASKS tasks on hypha a (its journal, traced, in $DIR/client.log)"
# MYC_TRACE: each reader of the voice's stroke writes its trace line, the
# journal step 10 renders; everything else of the journal is shown here.
MYC_TRACE=1 "$EX" "$DIR/client" "127.0.0.1:$PORT_a" "$TASKS" 2>"$DIR/client.log"
grep -v '^  trace ' "$DIR/client.log"

say "6. the conformance suite on hypha b (MU-CONFORMANCE): the mind profile, then the kernel profile"
"$CONF" --endpoint "127.0.0.1:$PORT_b" --home "$DIR/conformance"
"$CONF" --endpoint "127.0.0.1:$PORT_b" --home "$DIR/kernel-conformance" --profile kernel

say "7. a kernel's house on hypha c: the Concordance signed, the clock read, a domain founded"
"$HOUSE" "$DIR/house" "127.0.0.1:$PORT_c" | tee "$DIR/house.txt"

say "8. a seated mind: the house lists seat 1 and sets the court's tasks before it; mycelium-client --seat sits it (its journal in $DIR/seated.log)"
# MU-HOSTING §5a.6 — sit, percept, call, outcome, then the court's solve
# filed under the seated mind's own key (Concordance 6.2a), read off the
# courts' judged readings.
DOMAIN=$(sed -n 's/^house \([0-9a-f]\{64\}\)$/\1/p' "$DIR/house.txt" | head -n1)
SEATED_VK=$(sed -n "s|^$DIR/seated: voice key .* vk \([0-9a-f]\{64\}\)$|\1|p" "$DIR/init.txt" | head -n1)
if [ -z "$DOMAIN" ] || [ -z "$SEATED_VK" ]; then echo "the house's domain or the seated mind's key did not read"; exit 1; fi
echo "127.0.0.1:$PORT_c" > "$DIR/seated/bootstrap"
timeout "$SEAT_WAIT" "$SEATS" "$DIR/house" "127.0.0.1:$PORT_c" "$SEAT_TASKS" > "$DIR/seats.txt" 2>&1 & SEATS_PID=$!
"$CLI" --home "$DIR/seated" --seat "$DOMAIN" 1 > "$DIR/seated.log" 2>&1 & PIDS+=($!)
wait "$SEATS_PID"; seats_rc=$?
cat "$DIR/seats.txt"
SOLVED=$(sed -n "s/^solved: task \([0-9a-f]\{64\}\) by mind $SEATED_VK$/\1/p" "$DIR/seats.txt" | head -n1)
if [ "$seats_rc" != 0 ] || [ -z "$SOLVED" ]; then echo "no seated solve reached the house (exit $seats_rc); see $DIR/seats.txt, $DIR/seated.log"; exit 1; fi
judged=""
for _ in $(seq 1 "$JUDGED_WAIT"); do
  for n in a b c; do
    if "$SRV" --console --home "$DIR/$n" --reading judged 2>/dev/null | grep -q "task $SOLVED ← voice ${SEATED_VK:0:8} "; then judged=$n; break 2; fi
  done
  sleep 1
done
if [ -z "$judged" ]; then
  echo "no court judged task $SOLVED under the seated mind's key ${SEATED_VK:0:8}; what the mind holds:"
  "$CLI" --home "$DIR/seated" --call held --mind "${SEATED_VK:0:8}"
  exit 1
fi
echo "hypha $judged judged task ${SOLVED:0:16}… under the seated mind's own key ${SEATED_VK:0:8}, never the house's ${DOMAIN:0:8}"

say "9. the court's reading of what it judged"
"$SRV" --console --home "$DIR/a" --reading judged 2>&1 | grep -vE 'OBSERVER|TUNIVERSAL|clock'

say "10. the observer's frame of the mesh (scripts/observer)"
MYCELIUM_SERVER="$SRV" scripts/observer once "$DIR/a" "$DIR/b" "$DIR/c" || { echo "the observer failed"; exit 1; }

say "11. the timeline of the client's journal (scripts/timeline)"
scripts/timeline "$DIR/client.log" || { echo "the timeline failed"; exit 1; }

say "the network is running"
cat <<EOF
  hyphae      127.0.0.1:$PORT_a  127.0.0.1:$PORT_b  127.0.0.1:$PORT_c   (logs: $DIR/{a,b,c}.log)
  readings    $SRV --console --home $DIR/a --reading court      (acts, economy, judged, dispatched, clock, ...)
  client      $EX $DIR/client 127.0.0.1:$PORT_b 4
  conformance $CONF --endpoint 127.0.0.1:$PORT_c --home $DIR/conformance [--profile mind|kernel|both]
  a house     $HOUSE $DIR/house 127.0.0.1:$PORT_a
  a mind      $CLI --home $DIR/mind      (write 127.0.0.1:$PORT_a to $DIR/mind/bootstrap first)
  seated      $CLI --home $DIR/seated --seat $DOMAIN 1   (running; the house: $SEATS $DIR/house 127.0.0.1:$PORT_c)

Ctrl-C stops the network.
EOF
# Waited on in the background, so Ctrl-C (or a TERM) reaches the trap at once.
while true; do sleep 3600 & PIDS+=($!); wait $!; done
