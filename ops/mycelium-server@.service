[Unit]
Description=mycelium hypha %i
# A systemd user-unit template: one hypha per instance, its home under
# ~/.mycelium/%i. The checkout is assumed at ~/mycelium; edit both paths
# to where the repository is built.
[Service]
WorkingDirectory=%h/mycelium
ExecStart=%h/mycelium/target/release/mycelium-server --home %h/.mycelium/%i
Restart=always
RestartSec=1
[Install]
WantedBy=default.target
