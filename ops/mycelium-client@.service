[Unit]
Description=mycelium voice %i
# EXAMPLE systemd user-unit template, not installed by anything: one mind
# per instance, its home under ~/.mycelium/%i. Before use, edit
# WorkingDirectory and the binary path in ExecStart to where the repository
# is built (assumed here at ~/mycelium), and the --home path to where the
# mind's home is kept; then copy it to ~/.config/systemd/user/.
[Service]
WorkingDirectory=%h/mycelium
ExecStart=%h/mycelium/target/release/mycelium-client --home %h/.mycelium/%i
Restart=always
RestartSec=1
[Install]
WantedBy=default.target
